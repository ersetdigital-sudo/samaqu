# Base44 sandbox preview — non-secret defaults and boot placeholders.
#
# Loaded FIRST (see docker-compose.base44.yml). The platform's secret file
# /run/base44/app.env is loaded AFTER this file, so any real value the user
# supplies always overrides what is here.
#
# The app is Supabase-backed: NEXT_PUBLIC_SUPABASE_URL/ANON_KEY are read at module
# scope by src/lib/supabase.ts, so they must be non-empty for the app to boot at all.
# The values below are placeholders only — the catalog, accounts, orders and admin
# panels need the real hosted Supabase credentials.

# ── Supabase (required — real values come from /run/base44/app.env) ──
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ── Cloudinary (optional — product image storage/transforms) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD=placeholder-cloud
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# ── RajaOngkir (optional — shipping cost calculation; also stored in DB) ──
RAJAONGKIR_API_KEY=

# ── J&T Express (optional — tariff/order/track; defaults to the testing env) ──
JNT_ENV=testing
JNT_ORDER_USERNAME=
JNT_ORDER_API_KEY=
JNT_ORDER_KEY=
JNT_TARIFF_KEY=
JNT_TARIFF_CUS_NAME=
JNT_TRACK_USERNAME=
JNT_TRACK_PASSWORD=
JNT_COMPANY_ID=

# ── Internal endpoint secrets (used by cron/revalidate routes) ──
CRON_SECRET=placeholder-cron-secret
REVALIDATE_SECRET=placeholder-revalidate-secret

# ── Meta Pixel (optional — empty disables tracking) ──
NEXT_PUBLIC_META_PIXEL_ID=
